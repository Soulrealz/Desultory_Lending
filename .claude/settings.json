{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(forge --version)",
      "Bash(forge build *)",
      "Bash(forge test *)",
      "Bash(forge fmt --check *)",
      "Bash(PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 forge build *)",
      "Bash(PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 forge test *)",
      "Bash(medusa fuzz *)",
      "Bash(echidna . *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rm *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(git rebase *)",
      "Bash(forge script *)",
      "Bash(PRIVATE_KEY=* forge script *)",
      "Bash(cast send *)",
      "Edit(**/docs/Decisions/*.md)",
      "Bash(forge install *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git commit --no-verify *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(rm -rf *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/onchain/ethereum/lib/**)"
    ]
  }
}
